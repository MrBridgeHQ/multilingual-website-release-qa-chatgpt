  "journeys": [
    {
      "id": "J01",
      "title": "Open the requested home page",
      "critical": true,
      "priority": "P0",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Open /<language>/ in a fresh context.",
          "expected": "HTTP 200 and the requested language route load.",
          "expectation_basis": "SUPPLIED"
        },
        {
          "number": 2,
          "action": "Inspect html[lang], #page-heading, canonical, and hreflang links.",
          "expected": "The localized heading and all language/route metadata match tests/demo/product-contract.md.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    },
    {
      "id": "J02",
      "title": "Follow primary navigation",
      "critical": true,
      "priority": "P0",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Open /<language>/ and click #main-about.",
          "expected": "The destination is /<language>/about with HTTP 200 and the localized About heading.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    },
    {
      "id": "J03",
      "title": "Switch language from an internal page",
      "critical": true,
      "priority": "P0",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Open /<language>/about and click #language-switch.",
          "expected": "The other language's /about route opens, preserving the internal page.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    },
    {
      "id": "J04",
      "title": "Preserve language through a redirect",
      "critical": true,
      "priority": "P0",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Open /<language>/legacy and inspect its redirect when network collection is available.",
          "expected": "HTTP 302 redirects to /<language>/about; the original language and localized heading remain correct.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    },
    {
      "id": "J05",
      "title": "Search with matching results",
      "critical": true,
      "priority": "P0",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Open /<language>/search; type atlas in #search-query and click #search-submit.",
          "expected": "Exactly one .search-result is visible, the query remains, and #empty-state is absent.",
          "expectation_basis": "SUPPLIED"
        },
        {
          "number": 2,
          "action": "Click #result-about.",
          "expected": "The matching-language /about route and localized heading appear.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    },
    {
      "id": "J06",
      "title": "Search without a matching result",
      "critical": false,
      "priority": "P1",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Search for zzzz-no-match using #search-query and #search-submit.",
          "expected": "No .search-result appears; the retained query and localized empty state are visible: No results found. / Aucun résultat.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    },
    {
      "id": "J07",
      "title": "Validate an empty local form",
      "critical": false,
      "priority": "P1",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Open /<language>/contact; leave both inputs empty and click #contact-submit.",
          "expected": "Name and email errors are visible; fields have aria-invalid=true and confirmation is hidden.",
          "expectation_basis": "SUPPLIED"
        },
        {
          "number": 2,
          "action": "Compare both messages with the approved localized error strings.",
          "expected": "English: Enter your name. / Enter a valid email address. French: Saisissez votre nom. / Saisissez une adresse e-mail valide.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    },
    {
      "id": "J08",
      "title": "Complete the local form by keyboard",
      "critical": true,
      "priority": "P0",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Focus #contact-name and type Alex Test; press Tab.",
          "expected": "Focus reaches #contact-email with a visible outline.",
          "expectation_basis": "SUPPLIED"
        },
        {
          "number": 2,
          "action": "Type alex@example.test; press Tab and then Enter.",
          "expected": "Focus reaches #contact-submit; activation shows the localized confirmation without validation errors.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    },
    {
      "id": "J09",
      "title": "Use and close the mobile menu",
      "critical": true,
      "priority": "P0",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Open /<language>/ with the mobile profile; click #menu-toggle.",
          "expected": "The hidden menu becomes visible and aria-expanded changes from false to true.",
          "expectation_basis": "SUPPLIED"
        },
        {
          "number": 2,
          "action": "Click #mobile-about.",
          "expected": "The same-language /about page appears with the menu closed.",
          "expectation_basis": "SUPPLIED"
        },
        {
          "number": 3,
          "action": "Reopen the menu and press Escape.",
          "expected": "The menu closes, aria-expanded is false, and focus returns to #menu-toggle.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    },
    {
      "id": "J10",
      "title": "Read a localized offer on mobile",
      "critical": false,
      "priority": "P1",
      "preconditions": [
        "Start in a fresh browser context.",
        "Read the public product contract before execution."
      ],
      "test_data": {
        "name": "Alex Test",
        "email": "alex@example.test",
        "matching_query": "atlas",
        "empty_query": "zzzz-no-match"
      },
      "steps": [
        {
          "number": 1,
          "action": "Open /<language>/offer with the mobile profile.",
          "expected": "Title, currency, and date match the exact approved strings in tests/demo/product-contract.md.",
          "expectation_basis": "SUPPLIED"
        },
        {
          "number": 2,
          "action": "Measure document.documentElement.scrollWidth and window.innerWidth.",
          "expected": "scrollWidth is no more than innerWidth + 1; the offer CTA is inside the viewport.",
          "expectation_basis": "SUPPLIED"
        },
        {
          "number": 3,
          "action": "Click #offer-cta.",
          "expected": "The same-language /contact route opens.",
          "expectation_basis": "SUPPLIED"
        }
      ]
    }
  ],
