      "CSV"
    ],
    "output_language": "en"
  },
  "assumptions": [
    "This demo configuration defines exactly twenty journey-language pairs, not every device-language combination.",
    "The mobile profile is an emulated viewport, not a physical phone.",
    "No network country is requested or inferred.",
    "Atlas Studio, Atlas, Alex Test, and the fictional email are intentional retained terms.",
    "Record the observed browser version at execution; null here means the exact installed version has not yet been selected."
  ]
