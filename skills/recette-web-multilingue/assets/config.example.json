  "authentication": {
    "mode": "NONE",
    "reference": null,
    "authorization_note": "The synthetic local demo has no account and stores no contact-form submission."
  },
  "authorized_actions": [
    {
      "action": "NAVIGATE",
      "scope": "http://127.0.0.1:39175",
      "authorization": "The user requested local demo verification."
    },
    {
      "action": "CLICK",
      "scope": "http://127.0.0.1:39175",
      "authorization": "Read-only navigation and local interface controls are authorized."
    },
    {
      "action": "TYPE",
      "scope": "http://127.0.0.1:39175",
      "authorization": "Use only the fictional test data in this configuration."
    },
    {
      "action": "SUBMIT_FORM",
      "scope": "http://127.0.0.1:39175/<language>/contact",
      "authorization": "The local synthetic form only updates its page and has no external effect."
    }
